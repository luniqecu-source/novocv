# Opcional. Si defines un proxy propio, la clave de Gemini NUNCA viaja al navegador.
# El proxy debe aceptar POST y reenviar el cuerpo a
# https://generativelanguage.googleapis.com/v1beta/models/{modelo}:generateContent
VITE_AI_PROXY_URL=

# Modelo del asistente. gemini-2.5-flash es un alias estable y barato.
# Alternativas segun la documentacion vigente: gemini-3.5-flash, gemini-3.1-pro-preview.
# Para ver que modelos acepta tu clave:
#   curl https://generativelanguage.googleapis.com/v1beta/models -H "x-goog-api-key: TU_CLAVE"
VITE_AI_MODEL=gemini-2.5-flash
